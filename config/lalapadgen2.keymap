#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 2>;
        };
    };

    combos {
        compatible = "zmk,combos";

        CONBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        COMBO_TAB {
            bindings = <&kp TAB>;
            key-positions = <10 11>;
        };

        layer2 {
            bindings = <&sl 2>;
            key-positions = <12 13>;
        };

        jpn {
            bindings = <&kp LANG1>;
            key-positions = <33 34>;
        };

        eng {
            bindings = <&kp LANG2>;
            key-positions = <35 34>;
        };

        layer1 {
            bindings = <&mo 1>;
            key-positions = <36 37>;
        };

        layer2-2 {
            bindings = <&mo 2>;
            key-positions = <37 38>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&lt 3 Q            &kp W             &kp E         &kp R      &kp T                                 &kp Y                     &kp U          &lt 4 I                &kp O       &kp P
&kp A              &kp S             &kp D         &kp F      &kp G                                 &kp H                     &kp J          &kp K                  &kp L       &kp ENTER
&mt2 LEFT_SHIFT Z  &mt LEFT_SHIFT X  &kp C         &kp V      &kp B                                 &kp N                     &kp M          &kp COMMA              &kp PERIOD  &kp MINUS
&mt LCTRL TAB      &kp LWIN          &kp LEFT_ALT  &mkp MB1   &lt 1 SPACE  &mkp MB2  &kp BACKSPACE  &mt K_CONTEXT_MENU ENTER  &lt 3 ENTER    &mt RIGHT_SHIFT SLASH  &kp ESCAPE  &kp DELETE
                   &kp PRINTSCREEN   &kp RIGHT     &kp DOWN   &kp LEFT     &kp UP    &kp PAGE_UP    &mkp MB4                  &kp PAGE_DOWN  &mkp MB5               &mkp MB3
&mkp LCLK          &mkp RCLK         &mkp MCLK                                                                                               &mkp LCLK              &mkp RCLK   &mkp MCLK
&mkp MB4           &mkp MB5          &kp LG(TAB)   &kp LG(D)  &kp LCTRL                             &mkp MB4                  &mkp MB5       &kp LG(TAB)            &kp LG(D)   &kp LCTRL
            >;
        };

        SECONDARY_LAYER {
            display-name = "secondary_layer";
            bindings = <
&kp LA(LC(DELETE))  &kp LG(LEFT_ARROW)  &kp UP_ARROW         &kp LG(RIGHT_ARROW)  &kp SINGLE_QUOTE                            &kp KP_NUMLOCK      &kp KP_NUMBER_7     &kp KP_NUMBER_8      &kp KP_NUMBER_9  &kp KP_PLUS
&kp LC(TAB)         &kp LEFT_ARROW      &kp DOWN_ARROW       &kp RIGHT_ARROW      &kp COLON                                   &kp SLASH           &kp KP_NUMBER_4     &kp KP_NUMBER_5      &kp KP_NUMBER_6  &kp KP_MINUS
&kp LS(LC(TAB))     &kp LS(UP_ARROW)    &kp LA(DOWN_ARROW)   &kp UNDERSCORE       &kp SEMICOLON                               &kp EQUAL           &kp KP_NUMBER_1     &kp KP_NUMBER_2      &kp KP_NUMBER_3  &kp KP_ASTERISK
&kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)  &trans               &trans            &trans  &trans            &trans              &kp F2              &kp KP_NUMBER_0      &kp KP_DOT       &kp KP_DIVIDE
                    &trans              &trans               &trans               &trans            &trans  &kp LS(UP_ARROW)  &kp LS(LEFT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(RIGHT_ARROW)  &trans
&trans              &trans              &trans                                                                                                                        &trans               &trans           &trans
&kp LC(LG(LEFT))    &kp LC(LG(RIGHT))   &trans               &trans               &trans                                      &kp LC(LG(LEFT))    &kp LC(LG(RIGHT))   &trans               &trans           &trans
            >;
        };

        TERTIARY_LAYER {
            display-name = "tertiary_layer";
            bindings = <
&trans  &trans  &trans  &trans  &trans                           &kp DOLLAR       &kp AMPS           &kp GRAVE         &kp AT_SIGN           &kp CARET
&trans  &trans  &trans  &trans  &trans                           &kp UNDERSCORE   &kp DOUBLE_QUOTES  &kp SINGLE_QUOTE  &kp LEFT_BRACKET      &kp RIGHT_BRACKET
&trans  &trans  &trans  &trans  &trans                           &kp EXCLAMATION  &kp PERCENT        &kp POUND         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &trans             &kp ASTERISK      &kp BACKSLASH         &trans
        &trans  &trans  &trans  &trans  &trans  &kp C_VOLUME_UP  &kp C_PREVIOUS   &kp C_VOLUME_DOWN  &kp C_NEXT        &kp C_PLAY_PAUSE
&trans  &trans  &trans                                                                               &trans            &trans                &trans
&trans  &trans  &trans  &trans  &trans                           &trans           &trans             &trans            &trans                &trans
            >;
        };

        SYSTEM_LAYER {
            display-name = "system_layer";
            bindings = <
&kp F1   &kp F2   &kp F3               &kp F4              &kp F5                                        &out OUT_TOG                   &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_SEL 3
&kp F6   &kp F7   &kp F8               &kp F9              &kp F10                                       &sys_reset                     &bootloader                    &bt BT_CLR                     &bt BT_CLR_ALL                 &trans
&kp F11  &kp F12  &kp F13              &kp F14             &kp F15                                       &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans               &trans              &trans              &trans            &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &kp LS(RIGHT_ARROW)  &kp LS(DOWN_ARROW)  &kp LS(LEFT_ARROW)  &kp LS(UP_ARROW)  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                                                               &trans                         &trans                         &trans
&trans   &trans   &trans               &trans              &trans                                        &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans                        &trans          &mkp MB4        &trans           &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans                        &trans          &mkp MB1        &trans           &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans                        &trans          &trans          &trans           &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans          &trans          &trans           &trans    &trans
        &trans  &trans  &trans  &trans  &trans  &kp UP_ARROW  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&trans  &trans  &trans                                                                        &trans           &trans    &trans
&trans  &trans  &trans  &trans  &trans                        &trans          &trans          &trans           &trans    &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
